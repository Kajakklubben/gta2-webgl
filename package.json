{
  "name": "gta2-webgl",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx src/server/dev.ts",
    "build": "tsc --noEmit && vite build && tsup && node scripts/package-static.mjs",
    "build:static": "tsc --noEmit && STATIC_BUILD=1 vite build && node scripts/package-static.mjs",
    "deploy:ftp": "pnpm build:static && node scripts/upload-static-ftp.mjs",
    "deploy:ftp:code": "pnpm build:static && node scripts/upload-static-ftp.mjs --skip-assets",
    "start": "node dist/server/main.js",
    "init": "node scripts/init.mjs",
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:scenarios": "playwright test src/tests/e2e/vehicle-scenarios.spec.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "dev:fixture": "tsx src/tests/fixture-server.ts"
  },
  "dependencies": {
    "planck": "1.5.1",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
