<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".gmp" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".sty" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".scr" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".mmp" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".gci" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".gxt" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".seq" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".raw" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".sdt" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
